{
  "$schema": "https://json.schemastore.org/lintstaged.json",
  "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "biome check --write --no-errors-on-unmatched",
  "*.{json,jsonc}": "biome format --write --no-errors-on-unmatched",
  "*.svelte": "prettier --plugin prettier-plugin-svelte --write",
  "*.{css,md,html}": "prettier --write"
}
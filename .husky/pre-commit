#!/bin/sh
# .husky/pre-commit

# 1. Run formatting and linting (Biome) via lint-staged
# We prefer bun run lint-staged if available to ensure correct environment
if npm list lint-staged >/dev/null 2>&1 || bun pm ls | grep lint-staged >/dev/null; then
  bun run lint-staged || exit 1
fi

# 2. Bun Native API Check
# Find staged TypeScript/JavaScript/Svelte files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|js|svelte)$' || true)

if [ -n "$STAGED_FILES" ]; then

  # Check for synchronous Node.js APIs
  # We use a custom separator output for easier parsing if needed, but standard grep -n is fine
  FORBIDDEN=$(echo "$STAGED_FILES" | xargs grep -nE "fs\.writeFileSync|fs\.readFileSync|fs\.existsSync|fs\.mkdirSync" /dev/null 2>/dev/null || true)
  
  if [ -n "$FORBIDDEN" ]; then
    echo ""
    echo "❌ \033[0;31mCOMMIT REJECTED: Synchronous Node.js API detected!\033[0m"
    echo ""
    
    # Set Internal Field Separator to newline to loop over grep output lines
    IFS='
'
    for line in $FORBIDDEN; do
      FILE=$(echo "$line" | cut -d: -f1)
      LINE_NUM=$(echo "$line" | cut -d: -f2)
      CODE_CONTENT=$(echo "$line" | cut -d: -f3- | xargs) # xargs trims whitespace

      # Determine specific suggestion based on the matched function
      SUGGESTION=""
      if echo "$CODE_CONTENT" | grep -q "fs.writeFileSync"; then
        SUGGESTION="Replace with 'await Bun.write(path, data)' (3x faster)"
      elif echo "$CODE_CONTENT" | grep -q "fs.readFileSync"; then
        SUGGESTION="Replace with 'await Bun.file(path).text()' (or .arrayBuffer())"
      elif echo "$CODE_CONTENT" | grep -q "fs.existsSync"; then
        SUGGESTION="Replace with 'await Bun.file(path).exists()' (Async check)"
      elif echo "$CODE_CONTENT" | grep -q "fs.mkdirSync"; then
        SUGGESTION="Bun doesn't have native mkdir yet. Use 'import { mkdir } from \"node:fs/promises\"' and await it."
      fi

      echo "Path: $FILE"
      echo "Line: $LINE_NUM"
      echo ""
      echo "Comment:"
      echo "**performance:** Found synchronous Node.js I/O: \`$CODE_CONTENT\`."
      echo "This blocks the main thread and ignores Bun's native optimizations."
      echo ""
      echo "How can I resolve this?"
      echo "$SUGGESTION"
      echo "--------------------------------------------------"
    done
    unset IFS
    
    exit 1
  fi

  # 3. Console Usage Check
  # Reject console.log/warn/error in scripts, enforcing logger usage
  CONSOLE_LOGS=$(echo "$STAGED_FILES" | grep "^scripts/" | grep -v "scripts/lib/core/cli-logger.ts" | xargs grep -nE "console\.(log|warn|error)" /dev/null 2>/dev/null | grep -v "//" || true)

  if [ -n "$CONSOLE_LOGS" ]; then
    echo ""
    echo "❌ \033[0;31mCOMMIT REJECTED: Console logging detected!\033[0m"
    echo ""
    echo "Please use the structured logger instead of console.log/warn/error."
    echo ""
    
    IFS='
'
    for line in $CONSOLE_LOGS; do
      FILE=$(echo "$line" | cut -d: -f1)
      LINE_NUM=$(echo "$line" | cut -d: -f2)
      CODE_CONTENT=$(echo "$line" | cut -d: -f3- | xargs)
      
      echo "Path: $FILE"
      echo "Line: $LINE_NUM"
      echo ""
      echo "Code:"
      echo "  $CODE_CONTENT"
      echo ""
      echo "How can I resolve this?"
      echo "Import createLogger from 'scripts/lib/core/cli-logger' and use:"
      echo "  ✅ logger.info({ ctx }, \"Message\")"
      echo "  ✅ logger.raw(\"Message\") // For raw output"
      echo "--------------------------------------------------"
    done
    unset IFS
    
    exit 1
  fi

  # 4. Structured Logging Pattern Check
  # Check for unstructured logger calls
  # We exclude 'tests/' because tests often need to mock or intentionally use varying patterns
  UNSTRUCTURED_LOGS=$(echo "$STAGED_FILES" | grep -v "^tests/" | grep -v "scripts/lib/core/cli-logger.ts" | xargs grep -nE "(logger|log|child)\.(error|warn|info|debug|trace)\s*\(\s*[^{]" /dev/null 2>/dev/null | grep -v "{ " | grep -v "//" || true)
  
  if [ -n "$UNSTRUCTURED_LOGS" ]; then
    echo ""
    echo "❌ \033[0;31mCOMMIT REJECTED: Unstructured logging detected!\033[0m"
    echo ""
    echo "Found logger calls that don't use structured logging pattern."
    echo ""
    
    IFS='
'
    for line in $UNSTRUCTURED_LOGS; do
      FILE=$(echo "$line" | cut -d: -f1)
      LINE_NUM=$(echo "$line" | cut -d: -f2)
      CODE_CONTENT=$(echo "$line" | cut -d: -f3- | xargs)
      
      echo "Path: $FILE"
      echo "Line: $LINE_NUM"
      echo ""
      echo "Code:"
      echo "  $CODE_CONTENT"
      echo ""
      echo "How can I resolve this?"
      echo "Use structured logging pattern with context object as first argument:"
      echo "  ✅ logger.error({ err: error }, \"Operation failed\")"
      echo "  ✅ logger.warn({ userId, status }, \"Validation warning\")"
      echo "  ❌ logger.error(error)  // Missing context and message"
      echo "  ❌ logger.warn(\"Something failed\")  // No context data"
      echo "--------------------------------------------------"
    done
    unset IFS
    
    exit 1
  fi

  # 5. Dynamic Import Check
  # Reject dynamic imports (await import(...)) except for legitimate use cases:
  # - runtime.ts (Node.js fallback for fast-glob)
  # - Heavy dependencies (sharp, @fancyapps/ui, @vladmandic/face-api, @tensorflow, @xenova/transformers)
  # - Test files (Vitest mocking)
  # - Conditional server-side loading (+layout.server.ts, manifest-loader.ts)
  DYNAMIC_IMPORTS=$(echo "$STAGED_FILES" | \
    grep -v "scripts/lib/utils/runtime.ts" | \
    grep -v "tests/" | \
    grep -v "+layout.server.ts" | \
    grep -v "manifest-loader.ts" | \
    xargs grep -nE "await\s+import\s*\(" /dev/null 2>/dev/null | \
    grep -vE "(sharp|@fancyapps|@vladmandic|@tensorflow|@xenova|node:fs/promises|node:path|node:stream|canvas|pngjs)" || true)
  
  if [ -n "$DYNAMIC_IMPORTS" ]; then
    echo ""
    echo "❌ \033[0;31mCOMMIT REJECTED: Unexpected dynamic import detected!\033[0m"
    echo ""
    echo "Dynamic imports are only allowed for:"
    echo "  • Heavy dependencies (sharp, @fancyapps/ui, face-api, tensorflow, transformers)"
    echo "  • Test files (Vitest mocking)"
    echo "  • Runtime fallbacks (runtime.ts)"
    echo "  • Conditional server-side loading (+layout.server.ts, manifest-loader.ts)"
    echo ""
    echo "For runtime utilities, use top-level static imports instead."
    echo ""
    
    IFS='
'
    for line in $DYNAMIC_IMPORTS; do
      FILE=$(echo "$line" | cut -d: -f1)
      LINE_NUM=$(echo "$line" | cut -d: -f2)
      CODE_CONTENT=$(echo "$line" | cut -d: -f3- | xargs)
      
      echo "Path: $FILE"
      echo "Line: $LINE_NUM"
      echo ""
      echo "Code:"
      echo "  $CODE_CONTENT"
      echo ""
      echo "How can I resolve this?"
      echo "Move the import to the top of the file:"
      echo "  ❌ const { foo } = await import('./module')"
      echo "  ✅ import { foo } from './module'"
      echo "--------------------------------------------------"
    done
    unset IFS
    
    exit 1
  fi
fi

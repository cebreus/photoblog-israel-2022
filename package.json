{
  "name": "bun-svelte-photoblog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/manage.ts dev",
    "build": "bun scripts/manage.ts build",
    "preview": "bun scripts/manage.ts preview",
    "process": "bun scripts/manage.ts process",
    "analyze": "bun scripts/manage.ts analyze",
    "clean": "rm -rf build-* src/data/*/images.manifest.json src/data/*/curation.manifest.json",
    "images:build": "bun scripts/generate-images.ts",
    "faces:cluster": "bun scripts/face-clustering.ts",
    "lint": "biome check . && bun run lint:css",
    "lint:css": "stylelint '**/*.css'",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier \"**/*.{svelte,md,html,css}\" --plugin prettier-plugin-svelte -w -l",
    "format:check": "biome format . && prettier \"**/*.{svelte,md,html,css}\" --plugin prettier-plugin-svelte --check",
    "lint:ci": "biome check --reporter=summary --diagnostic-level=warn .",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:integration": "SHARP_NUM_THREADS=1 vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@clack/prompts": "^0.11.0",
    "@internationalized/date": "^3.10.1",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/bun": "^1.3.4",
    "@types/cli-progress": "^3.11.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/sharp": "^0.32.0",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "4.0.16",
    "@vladmandic/face-api": "^1.7.15",
    "bits-ui": "^2.14.4",
    "bun-types": "^1.3.4",
    "canvas": "^3.2.0",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "exiftool-vendored": "^34.1.0",
    "fast-glob": "^3.3.3",
    "formsnap": "^2.0.1",
    "mode-watcher": "^1.1.0",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-high-performance-animation": "^1.11.0",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "svelte-sonner": "^1.0.7",
    "sveltekit-superforms": "^2.29.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.16",
    "vitest-browser-svelte": "^2.0.1",
    "xxhash-wasm": "^1.1.0"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.7",
    "@xenova/transformers": "^2.17.2",
    "country-code-lookup": "^0.1.3",
    "favicons": "^7.2.0",
    "gray-matter": "^4.0.3",
    "lucide-svelte": "^0.561.0",
    "marked": "^17.0.1",
    "slugify": "^1.6.6",
    "winston": "^3.19.0"
  }
}

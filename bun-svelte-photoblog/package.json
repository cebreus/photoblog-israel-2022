{
  "name": "bun-svelte-photoblog",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:unit:images": "vitest -c vitest.config.images.ts --run --reporter verbose --include tests/unit/**/*.spec.ts",
    "test:images": "SHARP_NUM_THREADS=1 vitest -c vitest.config.images.ts --run --reporter verbose --include tests/integration/**/*.spec.ts --include tests/e2e-images/**/*.spec.ts",
    "test:all": "bun run test:unit:images && bun run test:images",
    "images:build": "bun scripts/generate-images.ts",
    "images:watch": "bun scripts/generate-images.ts --watch",
    "images:blur": "bun scripts/generate-images.ts --blur.enable=true --blur.only=true",
    "images:all": "bun run images:build && bun run images:blur",
    "prebuild": "bun run lint:ci && bun run images:build",
    "lint": "biome check . && bun run lint:css",
    "lint:css": "stylelint '**/*.css'",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier \"**/*.{svelte,md,html,css}\" --plugin prettier-plugin-svelte --write",
    "format:check": "biome format --write=false . && prettier \"**/*.{svelte,md,html,css}\" --plugin prettier-plugin-svelte --check",
    "lint:ci": "biome check --reporter=summary --diagnostic-level=warn ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@playwright/test": "^1.55.1",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.3.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/sharp": "^0.32.0",
    "@vitest/browser": "^3.2.4",
    "bun-types": "^1.1.20",
    "cli-progress": "^3.12.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.0.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "prettier": "^3",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.33.5",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^3.2.4",
    "vitest-browser-svelte": "^1.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "exifr": "^7.1.3",
    "marked": "^12.0.2"
  }
}

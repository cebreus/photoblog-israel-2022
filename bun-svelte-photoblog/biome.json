{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "files": {
    "includes": [
      "**/./**",
      "!**/node_modules",
      "!**/build",
      "!**/dist",
      "!**/.svelte-kit",
      "!**/.vite",
      "!**/static/images",
      "!**/static/**/*.jpg",
      "!**/static/**/*.jpeg",
      "!**/static/**/*.png",
      "!**/static/**/*.webp",
      "!**/static/**/*.avif",
      "!**/e2e/**/screenshots",
      "!**/tests/outputs",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  }
}

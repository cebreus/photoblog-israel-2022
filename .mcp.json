{
	"mcpServers": {
		"bun": {
			"command": "bunx",
			"args": [
				"-y",
				"mcp-bun@latest"
			],
			"env": {
				"DISABLE_NOTIFICATIONS": "true"
			}
		},
		"svelte": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@sveltejs/mcp"
			],
			"env": {}
		},
		"jsrepo": {
			"command": "npx",
			"args": [
				"jsrepo",
				"mcp"
			]
		}
	}
}
{
  "$schema": "https://biomejs.dev/schemas/2.3.9/schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "tests/**",
      "README.md",
      "package.json",
      "biome.json",
      "!**/node_modules/**",
      "!**/build/**",
      "!**/build-*/**",
      "!**/dist/**",
      "!**/.svelte-kit/**",
      "!**/.vite/**",
      "!**/.temp/**",
      "!**/*.css",
      "!**/*.svelte",
      "!src/data/**/*.json"
    ],
    "maxSize": 10485760
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "recommended": true,
        "useArrowFunction": "off"
      },
      "suspicious": {
        "recommended": true,
        "noConsole": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "recommended": true,
        "useBlockStatements": "off"
      },
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "globals": [
      "Bun"
    ]
  }
}
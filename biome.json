{
  "$schema": "https://biomejs.dev/schemas/2.3.9/schema.json",
  "files": {
    "includes": [
      "!**/.svelte-kit/**",
      "!**/.temp/**",
      "!**/.vite/**",
      "!**/*.css",
      "!**/*.svelte",
      "!**/build-*/**",
      "!**/build/**",
      "!**/dist/**",
      "!**/node_modules/**",
      "biome.json",
      "package.json",
      "README.md",
      "scripts/**",
      "src/**",
      "tests/**"
    ],
    "maxSize": 10485760
  },
  "overrides": [
    {
      "includes": ["scripts/**", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["src/data/**/*.manifest.json"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "recommended": true,
        "useArrowFunction": "off"
      },
      "suspicious": {
        "recommended": true,
        "noConsole": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "recommended": true,
        "useBlockStatements": "off"
      },
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  }
}

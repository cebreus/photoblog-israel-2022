{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "files": {
    "includes": [
      "biome.json",
      "package.json",
      "README.md",
      "scripts/**/*.ts",
      "src/**/*.ts",
      "src/**/*.js",
      "src/routes/**/*.svelte",
      "src/lib/components/*.svelte",
      "src/lib/components/debug/**/*.svelte",
      "src/lib/components/offcanvas/**/*.svelte",
      "src/lib/components/sidebar-content/**/*.svelte",
      "tests/**/*.ts"
    ],
    "maxSize": 10485760
  },
  "overrides": [
    {
      "includes": ["src/lib/paraglide/**/*"],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/data/**/*.manifest.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.svelte"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "recommended": true,
        "useArrowFunction": "off"
      },
      "suspicious": {
        "recommended": true,
        "noConsole": "warn",
        "noExplicitAny": "warn"
      },
      "style": {
        "recommended": true,
        "useConst": "off",
        "useImportType": "off"
      },
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  }
}
